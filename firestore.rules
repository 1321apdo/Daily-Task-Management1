rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile
    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().createdAt is timestamp;
      allow update: if isOwner(userId) &&
                       incoming().userId == existing().userId;
      allow delete: if isOwner(userId);

      // Tasks Subcollection
      match /tasks/{taskId} {
        allow read, write: if isOwner(userId);
      }

      // Appointments Subcollection
      match /appointments/{appointmentId} {
        allow read, write: if isOwner(userId);
      }

      // Ledger Transactions Subcollection
      match /ledger_transactions/{txId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && incoming().userId == request.auth.uid;
      }
    }
  }
}
